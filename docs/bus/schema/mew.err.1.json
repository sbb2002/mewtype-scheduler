{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mew.err/1",
  "title": "에러 봉투 (발신기 → 수신기)",
  "type": "object",
  "required": ["schema", "id", "ts", "source", "kind", "severity", "message"],
  "properties": {
    "schema": {"const": "mew.err/1"},
    "id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"},
    "source": {
      "type": "object",
      "required": ["env", "service"],
      "properties": {
        "env": {"enum": ["local", "stage", "prod"]},
        "service": {"type": "string", "maxLength": 64},
        "commit": {"type": "string", "maxLength": 40},
        "host": {"type": "string", "maxLength": 128}
      }
    },
    "kind": {"enum": ["log", "event"]},
    "severity": {"enum": ["CRITICAL", "ERROR", "WARN", "INFO", "DEBUG"]},
    "logger": {"type": "string", "maxLength": 200},
    "message": {"type": "string", "maxLength": 4000},
    "traceback": {"type": "string", "maxLength": 8000},
    "event": {
      "type": "object",
      "required": ["flow", "result"],
      "properties": {
        "flow": {"type": "string", "maxLength": 64},
        "result": {"enum": ["ok", "warn", "err"]},
        "who": {"type": "string", "maxLength": 64},
        "detail": {"type": "string", "maxLength": 4000}
      }
    },
    "context": {"type": "object"},
    "occurrences": {"type": "integer", "minimum": 1},
    "first_ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"},
    "last_ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"},
    "truncated": {"type": "boolean"},
    "redacted": {"type": "boolean"},
    "untrusted": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
