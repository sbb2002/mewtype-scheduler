+    def _get_raw(self, path: str) -> str:
+        """(1MB 초과 파일 폴백) 같은 URL 을 raw 미디어 타입으로 GET 해 본문 텍스트를 받는다.
+
+        Contents API 는 1MB 를 넘는 파일의 content 를 비워 돌려주므로(encoding='none'),
+        본문은 Accept: application/vnd.github.raw+json 으로 따로 받아야 한다.
+
+        Returns:
+            UTF-8 로 디코딩한 파일 본문.
+
+        Raises:
+            RuntimeError: 네트워크 오류 또는 200 이 아닌 상태코드.
+        """
+        url = f"{self.API}/repos/{self.repo}/contents/{path}"
+        params = {"ref": self.branch}
+        headers = dict(self._headers(), Accept="application/vnd.github.raw+json")
+        try:
+            sess = self.session or requests.Session()
+            resp = sess.get(url, params=params, headers=headers, timeout=self.timeout)
+        except requests.RequestException as e:
+            raise RuntimeError(f"GitHub API network error: {e}")
+
+        if resp.status_code != 200:
+            raise RuntimeError(
+                f"GitHub API read failed: {resp.status_code} {resp.reason}. "
+                f"Response: {resp.text[:200]}"
+            )
+        # resp.text 는 charset 미지정 시 requests 가 ISO-8859-1 로 추측해 한글이 깨지므로 바이트를 직접 UTF-8 디코딩
+        return resp.content.decode("utf-8")
+
