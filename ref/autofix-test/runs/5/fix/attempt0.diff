+    # 검증 7~10: 1MB 초과 파일 폴백 (content 비고 encoding='none' → raw 재요청)
+    class _BigSess:
+        """GET 은 Accept 가 raw 면 본문(바이트)을, 아니면 1MB 초과 응답(content 빈 값)을 돌려준다.
+        PUT 은 마지막 요청 body 를 기록한다."""
+        def __init__(self, body: str, sha: str = "shaBig"):
+            self.body, self.sha = body, sha
+            self.raw_calls, self.put_calls, self.last_put = 0, 0, None
+        def get(self, url, **kw):
+            if kw["headers"].get("Accept") == "application/vnd.github.raw+json":
+                self.raw_calls += 1
+                r = _Resp(200)
+                r.content = self.body.encode("utf-8")
+                r.text = self.body
+                return r
+            return _Resp(200, {"content": "", "encoding": "none", "size": 1138183, "sha": self.sha})
+        def put(self, url, **kw):
+            self.put_calls += 1
+            self.last_put = kw["json"]
+            return _Resp(200, {"content": {"sha": "newBig"}})
+
