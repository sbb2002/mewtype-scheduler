+/**
+ * (달 궤도 · Claude 안) 사진의 수평선 점 H0(가운데 열의 지평선)을 지나는 달 구면. 관측자는 구 밖 높이 h(반지름 1 기준)에 있고,
+ * 달 중심 방향 c = 하늘에서 달 가장자리(limb)가 H0 에서 moonFrame.T 방향으로 뻗는 작은 원의 중심. 우주 좌표.
+ * 돌려줌 = { c 달 중심 방향, cos 가장자리 코사인, L 중심까지 거리(R=1), up H0 에서의 위쪽, T 가장자리 접선, S 태양 방향 }
+ */
+export function moonSphere(C, h = 0.07) {
+  const { N, T } = moonFrame(C);
+  const A = norm3(cross3([0, 1, 0], C)), B = cross3(C, A);
+  const H0 = norm3([C[0] - 0.1758 * B[0], C[1] - 0.1758 * B[1], C[2] - 0.1758 * B[2]]);
+  const k = N[0] * H0[0] + N[1] * H0[1] + N[2] * H0[2];
+  const up = norm3([N[0] - k * H0[0], N[1] - k * H0[1], N[2] - k * H0[2]]);
+  const L = 1 + h, sinA = 1 / L, cosA = Math.sqrt(1 - sinA * sinA);
+  const c = norm3([H0[0] * cosA - up[0] * sinA, H0[1] * cosA - up[1] * sinA, H0[2] * cosA - up[2] * sinA]);
+  const S = norm3([-T[0] * 0.9 + up[0] * 0.42 + H0[0] * 0.1, -T[1] * 0.9 + up[1] * 0.42 + H0[1] * 0.1, -T[2] * 0.9 + up[2] * 0.42 + H0[2] * 0.1]);
+  return { c, cos: cosA, L, up, T, S, H0 };
+}
